{
  "name": "q-admin-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "polyfill": "node ./scripts/fix_keep_alive.cjs",
    "dev": "pnpm run polyfill && vite --force",
    "build": "pnpm run polyfill && run-p type-check \"build-only {@}\" --",
    "preview": "pnpm run polyfill && pnpm run build && vite preview",
    "build-only": "pnpm run polyfill && vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "element-plus": "^2.13.0",
    "lodash-es": "^4.17.22",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "plus-pro-components": "^0.1.30",
    "qs": "^6.14.0",
    "ts-md5": "^2.0.1",
    "utils94": "^2.2.74",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.50",
    "@plus-pro-components/resolver": "^0.0.3",
    "@tsconfig/node20": "^20.1.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-uno": "^66.5.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "sass": "1.79.3",
    "typescript": "~5.9.3",
    "unocss": "^66.5.10",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.1"
  }
}
