{
  "name": "q-admin-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "polyfill": "node ./scripts/fix_keep_alive.cjs",
    "dev": "pnpm run polyfill && vite --force",
    "build": "pnpm run polyfill && run-p type-check \"build-only {@}\" --",
    "preview": "pnpm run polyfill && pnpm run build && vite preview",
    "build-only": "pnpm run polyfill && vite build",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write src",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "element-plus": "^2.11.8",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "plus-pro-components": "^0.1.30",
    "qs": "^6.14.0",
    "rxjs": "^7.8.2",
    "ts-md5": "^2.0.1",
    "utils94": "^2.2.73",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.46",
    "@plus-pro-components/resolver": "^0.0.3",
    "@tsconfig/node20": "^20.1.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@unocss/preset-icons": "^66.5.7",
    "@unocss/preset-uno": "^66.5.7",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.29.0",
    "prettier": "^3.6.2",
    "sass": "1.79.3",
    "typescript": "~5.9.3",
    "unocss": "^66.5.7",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  },
  "license": "MIT"
}